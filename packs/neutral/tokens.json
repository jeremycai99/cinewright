{
  "palette": {
    "bg": "#FAFAF9",
    "surface": "#EEEEEB",
    "ink": "#16181D",
    "ink_muted": "#4A4F57",
    "accent": "#1F5FBF",
    "on_accent": "#FFFFFF",
    "line": "#80858E",
    "data": {
      "1": "#1F5FBF",
      "2": "#C2410C",
      "3": "#15803D",
      "4": "#7E3AAF",
      "5": "#0F766E",
      "6": "#A15C07"
    }
  },
  "contrast": {
    "text_min": 4.5,
    "large_text_min": 3,
    "graphic_min": 3
  },
  "type": {
    "family": {
      "display": "Inter",
      "body": {
        "token": "type.family.display"
      }
    },
    "weight": {
      "regular": 400,
      "bold": 600,
      "display": 700
    },
    "size": {
      "caption": 2.6,
      "small": 3,
      "body": 3.7,
      "subtitle": 4.6,
      "title": 6.5,
      "display": {
        "by_aspect": {
          "landscape": 9.6,
          "portrait": 8.4
        }
      }
    },
    "leading": {
      "tight": 1.1,
      "normal": 1.35
    },
    "tracking": {
      "display": -0.02,
      "body": 0
    },
    "transform": {
      "display": "none"
    }
  },
  "layout": {
    "margin": 4,
    "gutter": 2,
    "columns": {
      "by_aspect": {
        "landscape": 12,
        "portrait": 4
      }
    },
    "rows": {
      "by_aspect": {
        "landscape": 6,
        "portrait": 8
      }
    },
    "radius": 0.6,
    "stroke": 0.25
  },
  "density": {
    "max_lines_title": 3,
    "max_bullets": 5,
    "max_words_bullet": 10,
    "min_text_size": 2.4,
    "hold_per_word": 250,
    "min_hold": 1500
  },
  "motion": {
    "ease": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "enter": "cubic-bezier(0, 0, 0.2, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)",
      "emphasis": "cubic-bezier(0.3, 0, 0, 1)"
    },
    "duration": {
      "xs": 120,
      "s": 200,
      "m": 320,
      "l": 480,
      "xl": 800
    },
    "stagger": 60,
    "distance": 2.5,
    "entrance": "rise",
    "exit": "fade",
    "text_reveal": "lines",
    "preset": {
      "fade": {
        "enabled": true
      },
      "rise": {
        "enabled": true
      },
      "slide": {
        "enabled": true
      },
      "scale": {
        "enabled": true
      },
      "wipe": {
        "enabled": true
      },
      "pop": {
        "enabled": false
      }
    }
  },
  "camera": {
    "ken_burns": {
      "scale": 1.05,
      "ease": {
        "token": "motion.ease.standard"
      }
    }
  },
  "transition": {
    "default": "cross_dissolve",
    "cross_dissolve": {
      "enabled": true,
      "duration": 400
    },
    "wipe": {
      "enabled": true,
      "duration": 500,
      "direction": "left",
      "softness": 0.15
    }
  },
  "sound": {
    "music": {
      "genre": "unobtrusive ambient",
      "mood": "calm, focused",
      "bpm_min": 70,
      "bpm_max": 110
    },
    "sfx": {
      "family": "subtle interface",
      "enabled": false
    },
    "duck": {
      "depth_db": -12,
      "attack": 120,
      "release": 600
    },
    "bus": {
      "music_db": -8,
      "sfx_db": -12
    },
    "voice": {
      "head": 400,
      "line_gap": 300,
      "tail": 600
    }
  },
  "ext": {}
}
