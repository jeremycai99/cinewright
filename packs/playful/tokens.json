{
  "palette": {
    "bg": "#FFF7E8",
    "surface": "#FFE8C2",
    "ink": "#2A1950",
    "ink_muted": "#584675",
    "accent": "#C8204D",
    "on_accent": "#FFFFFF",
    "line": "#8C6D3F",
    "data": {
      "1": "#C8204D",
      "2": "#1565C0",
      "3": "#2E7D32",
      "4": "#6A3FD1",
      "5": "#B04A00",
      "6": "#00737F"
    }
  },
  "contrast": {
    "text_min": 4.5,
    "large_text_min": 3,
    "graphic_min": 3
  },
  "type": {
    "family": {
      "display": "Fredoka",
      "body": {
        "token": "type.family.display"
      }
    },
    "weight": {
      "regular": 400,
      "bold": 600,
      "display": 600
    },
    "size": {
      "caption": 2.8,
      "small": 3.2,
      "body": 4,
      "subtitle": 5,
      "title": 7.2,
      "display": {
        "by_aspect": {
          "landscape": 10.5,
          "portrait": 9
        }
      }
    },
    "leading": {
      "tight": 1.05,
      "normal": 1.4
    },
    "tracking": {
      "display": 0,
      "body": 0.01
    },
    "transform": {
      "display": "none"
    }
  },
  "layout": {
    "margin": 5,
    "gutter": 2.5,
    "columns": {
      "by_aspect": {
        "landscape": 12,
        "portrait": 4
      }
    },
    "rows": {
      "by_aspect": {
        "landscape": 6,
        "portrait": 8
      }
    },
    "radius": 2.5,
    "stroke": 0.5
  },
  "density": {
    "max_lines_title": 3,
    "max_bullets": 4,
    "max_words_bullet": 8,
    "min_text_size": 2.6,
    "hold_per_word": 300,
    "min_hold": 1800
  },
  "motion": {
    "ease": {
      "standard": "cubic-bezier(0.4, 0, 0.2, 1)",
      "enter": "cubic-bezier(0.22, 1, 0.36, 1)",
      "exit": "cubic-bezier(0.55, 0, 1, 0.45)",
      "emphasis": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    },
    "duration": {
      "xs": 150,
      "s": 250,
      "m": 400,
      "l": 600,
      "xl": 900
    },
    "stagger": 90,
    "distance": 4,
    "entrance": "pop",
    "exit": "scale",
    "text_reveal": "words",
    "preset": {
      "fade": {
        "enabled": true
      },
      "rise": {
        "enabled": true
      },
      "slide": {
        "enabled": true
      },
      "scale": {
        "enabled": true
      },
      "wipe": {
        "enabled": true
      },
      "pop": {
        "enabled": true
      }
    }
  },
  "camera": {
    "ken_burns": {
      "scale": 1.08,
      "ease": {
        "token": "motion.ease.standard"
      }
    }
  },
  "transition": {
    "default": "wipe",
    "cross_dissolve": {
      "enabled": true,
      "duration": 350
    },
    "wipe": {
      "enabled": true,
      "duration": 450,
      "direction": "left",
      "softness": 0
    }
  },
  "sound": {
    "music": {
      "genre": "upbeat ukulele and light percussion",
      "mood": "cheerful, curious",
      "bpm_min": 110,
      "bpm_max": 140
    },
    "sfx": {
      "family": "soft pops and chimes",
      "enabled": true
    },
    "duck": {
      "depth_db": -10,
      "attack": 80,
      "release": 400
    },
    "bus": {
      "music_db": -6,
      "sfx_db": -10
    }
  },
  "ext": {}
}
