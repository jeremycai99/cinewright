# Everything here is local: generated by tools, specific to one machine, or media.
# Pins, lockfiles and configuration are tracked; see CONTRIBUTING.md.

# Dependencies and virtual environments
node_modules/
.venv

# Build output (TypeScript writes dist/ and its .tsbuildinfo per package)
dist/
*.tsbuildinfo

# Tool caches and local tool state
.cache/
.pytest_cache/
.ruff_cache/
__pycache__/
*.py[cod]
.superpowers/
.claude/settings.local.json

# Render output and generated media; media is never committed (AGENTS.md §6)
.cinewright/
out/
*.mp4
*.mov
*.wav

# Secrets and local environment
.env
.env.*
!.env.example

# OS and editor files
.DS_Store
.idea/
.vscode/
*.swp
# Duplicates that iCloud or Finder create on sync conflicts ("name 2", "name 2.ext")
* 2
* 2.*
