{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BulletRevealProps",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "title": {
      "x-readable": true,
      "description": "A heading above the list.",
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "items": {
      "x-readable": true,
      "description": "The points, revealed in order. More than the pack's density.max_bullets is marked as overflow.",
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "type": "string", "minLength": 1, "maxLength": 160 }
    }
  }
}
