{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChartProps",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "categories", "series"],
  "properties": {
    "kind": { "description": "Bars compare; a line shows a trend.", "enum": ["bar", "line"] },
    "categories": {
      "description": "Category or time-step labels, in order.",
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "type": "string", "minLength": 1, "maxLength": 24 }
    },
    "series": {
      "description": "Up to six series, one data colour each, in order. Each has one value per category; values below 0 draw as 0.",
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "values"],
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 40 },
          "values": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": { "type": "number" }
          }
        }
      }
    },
    "unit": {
      "description": "The unit, shown with the values (for example %).",
      "type": "string",
      "maxLength": 12
    }
  }
}
