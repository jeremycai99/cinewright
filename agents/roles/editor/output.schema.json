{
  "type": "object",
  "additionalProperties": false,
  "required": ["scenes"],
  "properties": {
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "duration"],
        "properties": {
          "id": {
            "type": "string"
          },
          "duration": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target_seconds", "flex", "sync"],
            "properties": {
              "target_seconds": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 120
              },
              "flex": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "sync": {
                "enum": ["voiceover", "music", "fixed"]
              }
            }
          },
          "transition_out": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
              "type": {
                "enum": ["cut", "cross_dissolve", "wipe", "match_cut"]
              },
              "duration_frames": {
                "type": "integer",
                "minimum": 0,
                "maximum": 120
              }
            }
          }
        }
      }
    },
    "shots": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "anchors"],
        "properties": {
          "id": {
            "type": "string"
          },
          "anchors": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start"],
            "properties": {
              "start": {
                "type": "object",
                "additionalProperties": false,
                "required": ["line", "point", "offset"],
                "properties": {
                  "line": {
                    "type": "string"
                  },
                  "point": {
                    "enum": ["start", "end"]
                  },
                  "offset": {
                    "type": "integer",
                    "minimum": -600,
                    "maximum": 600
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
