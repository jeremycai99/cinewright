      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "summary", "lines"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "lines": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "text"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z0-9_]+$" },
                "text": { "type": "string", "minLength": 1, "maxLength": 600 },
                "direction": { "type": "string", "maxLength": 200 },
                "on_screen_text": { "type": "string", "maxLength": 200 }
              }
            }
          }
        }
      }
    }
  }
}
