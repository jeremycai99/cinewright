{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinewright.invalid/ir/0/patch.schema.json",
  "title": "Patch",
  "description": "An IR patch (D30, M1 convention 10). Values are bare: the store adds wrappers and sets each state from the author.",
  "type": "object",
  "additionalProperties": false,
  "required": ["base_revision", "author", "mode", "reason", "ops"],
  "properties": {
    "base_revision": {
      "type": "integer",
      "minimum": 0
    },
    "author": {
      "$ref": "common.schema.json#/$defs/author"
    },
    "mode": {
      "enum": ["apply", "propose"]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "ops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/op"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/decision"
      }
    },
    "task": {
      "$ref": "common.schema.json#/$defs/task_record"
    }
  }
}
