{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinewright.invalid/pack/0/pack.schema.json",
  "title": "PackManifest",
  "description": "A style pack's manifest, pack.json (M2.1a).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "description",
    "license",
    "aspect_classes",
    "fonts",
    "retired_rules"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$",
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "aspect_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["landscape", "portrait", "square"]
      }
    },
    "fonts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/font"
      }
    },
    "retired_rules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
      }
    },
    "extends": {
      "description": "Reserved: pack composition comes after v0.1. A pack that sets it is rejected (pack.extends_reserved)."
    }
  },
  "$defs": {
    "font": {
      "title": "PackFont",
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "file", "weight", "style", "sha256", "license", "source"],
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "pattern": "^fonts/[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "weight": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        },
        "style": {
          "enum": ["normal", "italic"]
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "unicode_range": {
          "description": "The CSS unicode-range this file covers, when a family is split into several files.",
          "type": "string",
          "pattern": "^U\\+[0-9A-F?]{1,6}(-[0-9A-F]{1,6})?(,U\\+[0-9A-F?]{1,6}(-[0-9A-F]{1,6})?)*$"
        }
      }
    }
  }
}
