{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinewright.invalid/pack/0/examples.schema.json",
  "title": "ComponentExamples",
  "description": "A component's examples, examples.json (M2.4a): the specimen inputs. They hold no pack values, so the same examples render under any pack.",
  "type": "array",
  "minItems": 1,
  "items": {
    "$ref": "#/$defs/example"
  },
  "$defs": {
    "example": {
      "title": "ComponentExample",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "template", "region", "duration_ms", "props"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "template": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "region": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        },
        "props": {
          "type": "object"
        },
        "motion": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["preset"],
            "properties": {
              "preset": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "params": {
                "type": "object"
              }
            }
          }
        },
        "overrides": {
          "description": "Layer token overrides, as an IR layer's style.overrides values.",
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["token"],
                "properties": {
                  "token": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
                  }
                }
              }
            ]
          }
        },
        "assets": {
          "description": "Asset id \u2192 a file in the component folder, copied into the specimen.",
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*$"
          }
        }
      }
    }
  }
}
