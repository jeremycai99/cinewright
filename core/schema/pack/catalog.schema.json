{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinewright.invalid/pack/0/catalog.schema.json",
  "title": "ComponentEntry",
  "description": "A component's catalog entry, component.json (M2.4a). Agents choose components from the catalog (D31).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "name", "runtime", "catalog", "tokens", "templates"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "description": "How it animates. Core components use waapi; a gsap component must state its licence.",
      "enum": ["waapi", "gsap"]
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "catalog": {
      "title": "CatalogText",
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "use_when", "avoid_when"],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "use_when": {
          "type": "string",
          "minLength": 1
        },
        "avoid_when": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tokens": {
      "description": "The vocabulary paths it reads.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
      }
    },
    "templates": {
      "description": "The template regions it is designed to fill.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      }
    }
  }
}
