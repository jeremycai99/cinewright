{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinewright.invalid/ir/0/project.schema.json",
  "title": "Project",
  "description": "The project file, cinewright.json (D40). Sequence bodies live in sequences/<id>.json.",
  "x-entity": "project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "origin",
    "schema_version",
    "profiles",
    "title",
    "brief",
    "autonomy",
    "budget",
    "policies",
    "settings",
    "style",
    "deliverables",
    "sequences",
    "script",
    "cast",
    "assets"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "origin": {
      "$ref": "common.schema.json#/$defs/origin"
    },
    "locked": {
      "$ref": "common.schema.json#/$defs/entity_lock"
    },
    "schema_version": {
      "const": 1
    },
    "profiles": {
      "title": "ProfileCopies",
      "description": "Copies of the delivery profiles the deliverables use, keyed by profile id, with the hash of each body (convention 16). Written only by init.",
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/profile_copy"
      }
    },
    "packs": {
      "title": "PackPins",
      "description": "The style packs this project is pinned to, keyed by pack id: each pack's version and content hash (M3.1a, audit decision 5). Written only by init and `cinewright pack pin`; compiling fails when the pack on disk no longer matches its pin.",
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/pack_pin"
      }
    },
    "title": {
      "x-authorable": "field",
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "$ref": "common.schema.json#/$defs/state"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "brief": {
      "x-authorable": "field",
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "$ref": "common.schema.json#/$defs/state"
        },
        "value": {
          "type": "string",
          "maxLength": 20000
        }
      }
    },
    "autonomy": {
      "x-authorable": "field",
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "$ref": "common.schema.json#/$defs/state"
        },
        "value": {
          "enum": ["auto", "guided", "directed", "manual"]
        }
      }
    },
    "budget": {
      "x-authorable": "field",
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "$ref": "common.schema.json#/$defs/state"
        },
        "value": {
          "$ref": "#/$defs/budget"
        }
      }
    },
    "policies": {
      "x-authorable": "field",
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "$ref": "common.schema.json#/$defs/state"
        },
        "value": {
          "$ref": "#/$defs/policies"
        }
      }
    },
    "settings": {
      "title": "ProjectSettings",
      "type": "object",
      "additionalProperties": false,
      "required": ["propose_conversational_edits"],
      "properties": {
        "propose_conversational_edits": {
          "description": "Conversational edits are proposed first and applied after the user approves (D25). On by default.",
          "x-authorable": "field",
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": {
            "state": {
              "$ref": "common.schema.json#/$defs/state"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        "providers": {
          "description": "Provider routing (D29): for each plugin kind, the plugin ids to use, in order. Unset means the free-first rule (free plugins, then paid plugins whose secrets are present, then by id).",
          "x-authorable": "field",
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": {
            "state": {
              "$ref": "common.schema.json#/$defs/state"
            },
            "value": {
              "title": "ProviderRouting",
              "type": "object",
              "propertyNames": {
                "enum": [
                  "llm",
                  "tts",
                  "music",
                  "sfx",
                  "image",
                  "video",
                  "lipsync",
                  "stt",
                  "stock",
                  "critic",
                  "exporter"
                ]
              },
              "additionalProperties": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$",
                  "maxLength": 64
                }
              }
            }
          }
        }
      }
    },
    "style": {
      "title": "ProjectStyle",
      "description": "The style pack and project-level token overrides (M1.3, M2.1).",
      "type": "object",
      "additionalProperties": false,
      "required": ["pack", "overrides"],
      "properties": {
        "pack": {
          "x-authorable": "field",
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": {
            "state": {
              "$ref": "common.schema.json#/$defs/state"
            },
            "value": {
              "$ref": "common.schema.json#/$defs/id"
            }
          }
        },
        "overrides": {
          "$ref": "style.schema.json#/$defs/overrides"
        }
      }
    },
    "deliverables": {
      "x-authorable": "list",
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "$ref": "common.schema.json#/$defs/state"
        },
        "value": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/deliverable"
          }
        }
      }
    },
    "sequences": {
      "description": "Sequence ids in order; each body is stored in sequences/<id>.json (convention 7).",
      "x-authorable": "list",
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "$ref": "common.schema.json#/$defs/state"
        },
        "value": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id",
            "x-ref": "sequence"
          }
        }
      }
    },
    "script": {
      "$ref": "script.schema.json"
    },
    "cast": {
      "description": "The cast bible: narrators and characters (D29).",
      "x-authorable": "list",
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "$ref": "common.schema.json#/$defs/state"
        },
        "value": {
          "type": "array",
          "items": {
            "$ref": "cast.schema.json"
          }
        }
      }
    },
    "assets": {
      "description": "The asset registry: every asset the IR references, by content hash (AGENTS.md \u00a76).",
      "x-authorable": "list",
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "$ref": "common.schema.json#/$defs/state"
        },
        "value": {
          "type": "array",
          "items": {
            "$ref": "asset.schema.json"
          }
        }
      }
    }
  },
  "$defs": {
    "profile_copy": {
      "title": "ProfileCopy",
      "type": "object",
      "additionalProperties": false,
      "required": ["hash", "body"],
      "properties": {
        "hash": {
          "$ref": "common.schema.json#/$defs/hash"
        },
        "body": {
          "$ref": "delivery-profile.schema.json"
        }
      }
    },
    "budget": {
      "title": "Budget",
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "cap"],
      "properties": {
        "currency": {
          "const": "USD"
        },
        "cap": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "policies": {
      "title": "Policies",
      "type": "object",
      "additionalProperties": false,
      "required": ["require_commercial_license"],
      "properties": {
        "require_commercial_license": {
          "type": "boolean"
        }
      }
    },
    "deliverable": {
      "title": "Deliverable",
      "description": "One output of the project, rendered from the shared timeline with one delivery profile (D28).",
      "x-entity": "deliverable",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "origin", "profile", "label", "burn_in_captions"],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "origin": {
          "$ref": "common.schema.json#/$defs/origin"
        },
        "locked": {
          "$ref": "common.schema.json#/$defs/entity_lock"
        },
        "profile": {
          "x-authorable": "field",
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": {
            "state": {
              "$ref": "common.schema.json#/$defs/state"
            },
            "value": {
              "$ref": "common.schema.json#/$defs/id"
            }
          }
        },
        "label": {
          "x-authorable": "field",
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": {
            "state": {
              "$ref": "common.schema.json#/$defs/state"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        },
        "burn_in_captions": {
          "x-authorable": "field",
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": {
            "state": {
              "$ref": "common.schema.json#/$defs/state"
            },
            "value": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "pack_pin": {
      "title": "PackPin",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "hash"],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "$ref": "common.schema.json#/$defs/hash"
        }
      }
    }
  }
}
