{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinewright.invalid/ir/0/project.schema.json",
  "title": "Project",
  "description": "The project file, cinewright.json (D40). Sequence bodies live in sequences/<id>.json.",
  "x-entity": "project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "origin",
    "schema_version",
    "profiles",
    "title",
    "brief",
    "autonomy",
    "budget",
    "policies",
    "settings",
    "style",
    "deliverables",
    "sequences"
  ],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "origin": { "$ref": "common.schema.json#/$defs/origin" },
    "locked": { "$ref": "common.schema.json#/$defs/entity_lock" },
    "schema_version": { "const": 1 },
    "profiles": {
      "title": "ProfileCopies",
      "description": "Copies of the delivery profiles the deliverables use, keyed by profile id, with the hash of each body (convention 16). Written only by init.",
      "type": "object",
      "propertyNames": { "$ref": "common.schema.json#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/profile_copy" }
    },
    "title": {
      "x-authorable": "field",
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "$ref": "common.schema.json#/$defs/state" },
        "value": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "brief": {
      "x-authorable": "field",
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "$ref": "common.schema.json#/$defs/state" },
        "value": { "type": "string", "maxLength": 20000 }
      }
    },
    "autonomy": {
      "x-authorable": "field",
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "$ref": "common.schema.json#/$defs/state" },
        "value": { "enum": ["auto", "guided", "directed", "manual"] }
      }
    },
    "budget": {
      "x-authorable": "field",
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "$ref": "common.schema.json#/$defs/state" },
        "value": { "$ref": "#/$defs/budget" }
      }
    },
    "policies": {
      "x-authorable": "field",
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "$ref": "common.schema.json#/$defs/state" },
        "value": { "$ref": "#/$defs/policies" }
      }
    },
    "settings": {
      "title": "ProjectSettings",
      "type": "object",
      "additionalProperties": false,
      "required": ["propose_conversational_edits"],
      "properties": {
        "propose_conversational_edits": {
          "description": "Conversational edits are proposed first and applied after the user approves (D25). On by default.",
          "x-authorable": "field",
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": {
            "state": { "$ref": "common.schema.json#/$defs/state" },
            "value": { "type": "boolean" }
          }
        }
      }
    },
    "style": {
      "title": "ProjectStyle",
      "description": "The style pack and project-level token overrides (M1.3, M2.1).",
      "type": "object",
      "additionalProperties": false,
      "required": ["pack", "overrides"],
      "properties": {
        "pack": {
          "x-authorable": "field",
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": {
            "state": { "$ref": "common.schema.json#/$defs/state" },
            "value": { "$ref": "common.schema.json#/$defs/id" }
          }
        },
        "overrides": { "$ref": "#/$defs/style_overrides" }
      }
    },
    "deliverables": {
      "x-authorable": "list",
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "$ref": "common.schema.json#/$defs/state" },
        "value": { "type": "array", "items": { "$ref": "#/$defs/deliverable" } }
      }
    },
    "sequences": {
      "description": "Sequence ids in order; each body is stored in sequences/<id>.json (convention 7).",
      "x-authorable": "list",
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "$ref": "common.schema.json#/$defs/state" },
        "value": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/id", "x-ref": "sequence" }
        }
      }
    }
  },
  "$defs": {
    "profile_copy": {
      "title": "ProfileCopy",
      "type": "object",
      "additionalProperties": false,
      "required": ["hash", "body"],
      "properties": {
        "hash": { "$ref": "common.schema.json#/$defs/hash" },
        "body": { "$ref": "delivery-profile.schema.json" }
      }
    },
    "budget": {
      "title": "Budget",
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "cap"],
      "properties": {
        "currency": { "const": "USD" },
        "cap": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "policies": {
      "title": "Policies",
      "type": "object",
      "additionalProperties": false,
      "required": ["require_commercial_license"],
      "properties": {
        "require_commercial_license": { "type": "boolean" }
      }
    },
    "style_overrides": {
      "title": "StyleOverrides",
      "description": "Token overrides at this level, one wrapper per token path (convention 7).",
      "x-authorable": "map",
      "type": "object",
      "propertyNames": { "$ref": "common.schema.json#/$defs/token_path" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state"],
        "properties": {
          "state": { "$ref": "common.schema.json#/$defs/state" },
          "value": { "$ref": "common.schema.json#/$defs/token_value" }
        }
      }
    },
    "deliverable": {
      "title": "Deliverable",
      "description": "One output of the project, rendered from the shared timeline with one delivery profile (D28).",
      "x-entity": "deliverable",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "origin", "profile", "label", "burn_in_captions"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "origin": { "$ref": "common.schema.json#/$defs/origin" },
        "locked": { "$ref": "common.schema.json#/$defs/entity_lock" },
        "profile": {
          "x-authorable": "field",
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": {
            "state": { "$ref": "common.schema.json#/$defs/state" },
            "value": { "$ref": "common.schema.json#/$defs/id" }
          }
        },
        "label": {
          "x-authorable": "field",
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": {
            "state": { "$ref": "common.schema.json#/$defs/state" },
            "value": { "type": "string", "minLength": 1, "maxLength": 200 }
          }
        },
        "burn_in_captions": {
          "x-authorable": "field",
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": {
            "state": { "$ref": "common.schema.json#/$defs/state" },
            "value": { "type": "boolean" }
          }
        }
      }
    }
  }
}
