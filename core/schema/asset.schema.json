{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinewright.invalid/ir/0/asset.schema.json",
  "title": "Asset",
  "description": "A content-addressed asset (D33). All fields are measured data, so none is authorable; list membership is.",
  "x-entity": "asset",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "origin", "hash", "media_type", "bytes", "role", "provenance", "license"],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "origin": {
      "$ref": "common.schema.json#/$defs/origin"
    },
    "locked": {
      "$ref": "common.schema.json#/$defs/entity_lock"
    },
    "hash": {
      "$ref": "common.schema.json#/$defs/hash"
    },
    "media_type": {
      "type": "string",
      "pattern": "^[a-z]+/[a-z0-9.+-]+$"
    },
    "bytes": {
      "type": "integer",
      "minimum": 0
    },
    "role": {
      "enum": [
        "take",
        "music",
        "sfx",
        "image",
        "video",
        "font",
        "composition",
        "reference",
        "consent",
        "transcript",
        "other"
      ]
    },
    "line": {
      "description": "The line a take performs (takes only, D26).",
      "$ref": "common.schema.json#/$defs/id",
      "x-ref": "line"
    },
    "take": {
      "description": "The take a transcript transcribes (transcripts only).",
      "$ref": "common.schema.json#/$defs/id",
      "x-ref": "asset"
    },
    "sequence": {
      "description": "The sequence a music bed scores (music only).",
      "$ref": "common.schema.json#/$defs/id",
      "x-ref": "sequence"
    },
    "scene": {
      "description": "The scene a sound effect plays in (SFX only).",
      "$ref": "common.schema.json#/$defs/id",
      "x-ref": "scene"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "license": {
      "$ref": "common.schema.json#/$defs/license"
    },
    "audio": {
      "$ref": "#/$defs/audio"
    },
    "aligned_by": {
      "description": "The plugin and model that aligned the take's words, when they are not the TTS provider's own (takes only).",
      "type": "string",
      "minLength": 1
    },
    "words": {
      "description": "Word timestamps in samples at the asset's own audio.sample_rate (takes only), one per script word (lineWords).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/word"
      }
    }
  },
  "$defs": {
    "provenance": {
      "description": "Who or what produced the asset (AGENTS.md §6).",
      "title": "Provenance",
      "type": "object",
      "additionalProperties": false,
      "required": ["provider"],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string"
        },
        "plan_tier": {
          "type": "string"
        },
        "request_hash": {
          "$ref": "common.schema.json#/$defs/hash"
        }
      }
    },
    "word": {
      "title": "WordTiming",
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "start", "end"],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "$ref": "common.schema.json#/$defs/samples"
        },
        "end": {
          "$ref": "common.schema.json#/$defs/samples"
        },
        "interpolated": {
          "description": "True when the aligner gave this word no time and it was interpolated from its neighbours (M4: digits, symbols).",
          "type": "boolean"
        }
      }
    },
    "audio": {
      "title": "AudioInfo",
      "description": "Measured format of an audio asset. Word times are in samples at this sample_rate.",
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_rate", "channels", "samples"],
      "properties": {
        "sample_rate": {
          "type": "integer",
          "minimum": 1
        },
        "channels": {
          "type": "integer",
          "minimum": 1
        },
        "samples": {
          "description": "Length in samples per channel.",
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
