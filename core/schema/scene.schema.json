{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinewright.invalid/ir/0/scene.schema.json",
  "title": "Scene",
  "description": "A scene spec with typed fields (the spec's \"What a scene spec holds\").",
  "x-entity": "scene",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "origin",
    "intent",
    "duration",
    "mood",
    "cast",
    "lines",
    "transition_out",
    "sound",
    "gates",
    "style",
    "shots"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "origin": {
      "$ref": "common.schema.json#/$defs/origin"
    },
    "locked": {
      "$ref": "common.schema.json#/$defs/entity_lock"
    },
    "intent": {
      "x-authorable": "field",
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "$ref": "common.schema.json#/$defs/state"
        },
        "value": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "duration": {
      "x-authorable": "field",
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "$ref": "common.schema.json#/$defs/state"
        },
        "value": {
          "$ref": "#/$defs/scene_duration"
        }
      }
    },
    "mood": {
      "x-authorable": "field",
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "$ref": "common.schema.json#/$defs/state"
        },
        "value": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "cast": {
      "x-authorable": "field",
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "$ref": "common.schema.json#/$defs/state"
        },
        "value": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id",
            "x-ref": "cast_member"
          }
        }
      }
    },
    "lines": {
      "description": "Script lines in this scene, in order (D26).",
      "x-authorable": "field",
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "$ref": "common.schema.json#/$defs/state"
        },
        "value": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id",
            "x-ref": "line"
          }
        }
      }
    },
    "transition_out": {
      "x-authorable": "field",
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "$ref": "common.schema.json#/$defs/state"
        },
        "value": {
          "$ref": "#/$defs/transition"
        }
      }
    },
    "sound": {
      "x-authorable": "field",
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "$ref": "common.schema.json#/$defs/state"
        },
        "value": {
          "$ref": "#/$defs/scene_sound"
        }
      }
    },
    "gates": {
      "x-authorable": "field",
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "$ref": "common.schema.json#/$defs/state"
        },
        "value": {
          "type": "array",
          "items": {
            "enum": ["script", "storyboard", "animatic", "final"]
          }
        }
      }
    },
    "style": {
      "$ref": "style.schema.json#/$defs/level_style"
    },
    "shots": {
      "x-authorable": "list",
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "$ref": "common.schema.json#/$defs/state"
        },
        "value": {
          "type": "array",
          "items": {
            "$ref": "shot.schema.json"
          }
        }
      }
    }
  },
  "$defs": {
    "scene_duration": {
      "title": "SceneDuration",
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "flex", "sync"],
      "properties": {
        "target": {
          "$ref": "common.schema.json#/$defs/frames"
        },
        "flex": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sync": {
          "enum": ["voiceover", "music", "fixed"]
        }
      }
    },
    "transition": {
      "title": "Transition",
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["cut", "cross_dissolve", "wipe", "match_cut"]
        },
        "to": {
          "$ref": "common.schema.json#/$defs/id",
          "x-ref": "scene"
        },
        "duration": {
          "$ref": "common.schema.json#/$defs/frames"
        },
        "on": {
          "type": "string"
        }
      }
    },
    "scene_sound": {
      "title": "SceneSound",
      "type": "object",
      "additionalProperties": false,
      "required": ["sfx"],
      "properties": {
        "music_cue": {
          "type": "string"
        },
        "sfx": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "duck_under_vo_db": {
          "type": "number",
          "maximum": 0
        }
      }
    }
  }
}
