{
  "palette": {
    "bg": "#FFFFFF",
    "surface": "#F2F2F2",
    "ink": "#111111",
    "ink_muted": "#555555",
    "accent": "#0057B8",
    "on_accent": "#FFFFFF",
    "line": "#767676",
    "data": {
      "1": "#0057B8",
      "2": "#B35900",
      "3": "#2E7D32",
      "4": "#8E24AA",
      "5": "#C62828",
      "6": "#00796B"
    }
  },
  "contrast": { "text_min": 4.5, "large_text_min": 3, "graphic_min": 3 },
  "type": {
    "family": { "display": "Test Sans", "body": { "token": "type.family.display" } },
    "weight": { "regular": 400, "bold": 700, "display": 700 },
    "size": {
      "caption": 2.2,
      "small": 2.6,
      "body": 3.2,
      "subtitle": 4,
      "title": 6,
      "display": { "by_aspect": { "landscape": 9, "portrait": 8 } }
    },
    "leading": { "tight": 1.1, "normal": 1.4 },
    "tracking": { "display": -0.01, "body": 0 },
    "transform": { "display": "none" }
  },
  "layout": {
    "margin": 5,
    "gutter": 2,
    "columns": { "by_aspect": { "landscape": 12, "portrait": 4 } },
    "rows": { "by_aspect": { "landscape": 6, "portrait": 8 } },
    "radius": 0.5,
    "stroke": 0.2
  },
  "density": {
    "max_lines_title": 3,
    "max_bullets": 5,
    "max_words_bullet": 8,
    "min_text_size": 2,
    "hold_per_word": 300,
    "min_hold": 1500
  },
  "motion": {
    "ease": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "enter": "cubic-bezier(0, 0, 0, 1)",
      "exit": "cubic-bezier(0.3, 0, 1, 1)",
      "emphasis": { "token": "motion.ease.standard" }
    },
    "duration": { "xs": 100, "s": 200, "m": 400, "l": 700, "xl": 1200 },
    "stagger": 80,
    "distance": 4,
    "entrance": "rise",
    "exit": "fade",
    "text_reveal": "words",
    "preset": {
      "fade": { "enabled": true },
      "rise": { "enabled": true },
      "slide": { "enabled": true },
      "scale": { "enabled": true },
      "wipe": { "enabled": true },
      "pop": { "enabled": false }
    }
  },
  "camera": { "ken_burns": { "scale": 1.06, "ease": { "token": "motion.ease.standard" } } },
  "transition": {
    "default": "cross_dissolve",
    "cross_dissolve": { "enabled": true, "duration": 500 },
    "wipe": { "enabled": true, "duration": 600, "direction": "left", "softness": 0.2 }
  },
  "sound": {
    "voice": { "head": 400, "line_gap": 300, "tail": 600 },
    "music": { "genre": "ambient", "mood": "calm", "bpm_min": 70, "bpm_max": 110 },
    "sfx": { "family": "soft interface", "enabled": false },
    "duck": { "depth_db": -12, "attack": 80, "release": 400 },
    "bus": { "music_db": -6, "sfx_db": -10 }
  },
  "ext": {}
}
