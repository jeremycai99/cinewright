{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinewright.invalid/eval/0/rubric.schema.json",
  "title": "Rubric",
  "description": "A versioned rubric for the vision critic (M6.2): criteria at the shot or scene level, each a question with anchored descriptions for scores 1 to 5. Phrased against the brief, the resolved pack rules and the craft rules; never against a look.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "floor", "criteria"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "version": { "type": "string", "minLength": 1 },
    "floor": {
      "description": "A score at or under this raises a finding's priority in the fix loop (vision.floor).",
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "level", "question", "anchors"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "level": { "enum": ["shot", "scene"] },
          "question": { "type": "string", "minLength": 1 },
          "craft_rules": { "type": "array", "items": { "type": "string" } },
          "anchors": {
            "type": "object",
            "additionalProperties": false,
            "required": ["1", "3", "5"],
            "properties": {
              "1": { "type": "string" },
              "2": { "type": "string" },
              "3": { "type": "string" },
              "4": { "type": "string" },
              "5": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
