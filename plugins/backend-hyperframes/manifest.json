{
  "schema_version": 1,
  "id": "backend_hyperframes",
  "version": "0.1.0",
  "kind": "backend",
  "capabilities": [
    "backend.html",
    "render.plan",
    "render.composition",
    "render.shot",
    "render.segment",
    "render.keyframes"
  ],
  "cost_model": {
    "unit": "free"
  },
  "latency_class": "batch",
  "output_license": {
    "terms": "Apache-2.0",
    "commercial_use": true
  },
  "secrets": [],
  "runtime": {
    "kind": "in_process",
    "entry": "./dist/index.js"
  },
  "concurrency": {
    "max_parallel": 1
  },
  "rate_limits": []
}
