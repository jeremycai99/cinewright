{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinewright.invalid/plugin/0/kinds/critic.schema.json",
  "title": "CriticKind",
  "description": "Requests and results of critic plugins (M6.1). A critic reads artifacts and returns findings; it never writes the IR. `finding` mirrors core/schema/finding.schema.json.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        }
      }
    },
    "run_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "deliverable", "timing", "artifacts"],
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1
        },
        "deliverable": {
          "type": "string",
          "minLength": 1
        },
        "timing": {
          "type": "object",
          "required": ["table", "sequences", "scenes", "shots"],
          "properties": {
            "table": {
              "type": "object"
            },
            "sequences": {
              "type": "object"
            },
            "scenes": {
              "type": "object"
            },
            "shots": {
              "type": "object"
            },
            "frames": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "pack_path": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["renders"],
          "properties": {
            "assembly": {
              "type": "string",
              "minLength": 1
            },
            "renders": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "captions": {
              "type": "object",
              "additionalProperties": false,
              "required": ["srt", "vtt"],
              "properties": {
                "srt": {
                  "type": "string",
                  "minLength": 1
                },
                "vtt": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "shots": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              }
            }
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "signature",
        "rule",
        "severity",
        "entity",
        "message",
        "data",
        "critic",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^f_[0-9a-f]{12}$"
        },
        "signature": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "rule": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
        },
        "severity": {
          "enum": ["error", "warning"]
        },
        "entity": {
          "type": "string",
          "minLength": 1
        },
        "pointer": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "data": {
          "type": "object"
        },
        "critic": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "deliverable": {
          "$ref": "#/$defs/id"
        },
        "frames": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "measured": {
              "type": "number"
            },
            "limit": {
              "type": "number"
            },
            "selector": {
              "type": "string"
            },
            "box": {
              "$ref": "#/$defs/rect"
            },
            "region": {
              "$ref": "#/$defs/rect"
            },
            "still": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "code": {
              "type": "string"
            }
          }
        }
      }
    },
    "run_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["findings", "measured"],
      "properties": {
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "measured": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "baseline": {
          "description": "What the findings depend on besides the plugin version (D36): its settings hash, the HyperFrames version, ...",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
