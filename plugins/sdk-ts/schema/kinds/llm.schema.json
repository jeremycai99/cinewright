{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinewright.invalid/plugin/0/kinds/llm.schema.json",
  "title": "LlmKind",
  "description": "Requests and results of LLM plugins (M7.3). Provider-neutral: a tier or an opaque pin, never a model name; no sampling parameters, so reproducibility comes only from cassettes. Images are work files with their content hash.",
  "$defs": {
    "file": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"
    },
    "content": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "text"],
          "properties": { "type": { "const": "text" }, "text": { "type": "string" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "file", "hash", "media_type"],
          "properties": {
            "type": { "const": "image" },
            "file": { "$ref": "#/$defs/file" },
            "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "media_type": { "enum": ["image/png", "image/jpeg", "image/webp", "image/gif"] }
          }
        }
      ]
    },
    "generate_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "system", "messages", "schema", "max_output_tokens"],
      "properties": {
        "tier": { "enum": ["frontier", "mid"] },
        "pin": { "type": "string", "minLength": 1, "maxLength": 64 },
        "system": { "type": "string" },
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "content"],
            "properties": {
              "role": { "enum": ["user", "assistant"] },
              "content": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/content" } }
            }
          }
        },
        "schema": { "type": "object" },
        "max_output_tokens": { "type": "integer", "minimum": 1 },
        "effort": { "enum": ["low", "medium", "high"] }
      }
    },
    "generate_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output", "model", "usage", "cost_usd", "stop"],
      "properties": {
        "output": {},
        "model": { "type": "string", "minLength": 1 },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_tokens", "output_tokens"],
          "properties": {
            "input_tokens": { "type": "integer", "minimum": 0 },
            "output_tokens": { "type": "integer", "minimum": 0 },
            "cached_tokens": { "type": "integer", "minimum": 0 }
          }
        },
        "cost_usd": { "type": "number", "minimum": 0 },
        "stop": { "enum": ["end", "max_tokens"] }
      }
    },
    "estimate_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["usd_max"],
      "properties": { "usd_max": { "type": "number", "minimum": 0 } }
    }
  }
}
