{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinewright.invalid/engine/0/workflow-template.schema.json",
  "title": "WorkflowTemplate",
  "description": "A workflow as data (M7.1b): phases in order. An agent phase runs its role once per `per` entity while a field it `requires` is open, or when what it `reads` changed since it last filled them. A jobs phase holds the pipeline steps of its kinds. A gate pauses until every field it `locks` is locked. Field patterns are `<entity kind>.<field>`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "phases"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "needs"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_]+$" },
          "kind": { "enum": ["agent", "jobs", "gate"] },
          "role": { "enum": ["producer", "writer", "director", "shot_builder", "editor"] },
          "gate": { "enum": ["script", "storyboard", "final"] },
          "steps": {
            "type": "array",
            "items": {
              "enum": [
                "narrate",
                "timing",
                "compose",
                "render",
                "segment",
                "mix",
                "captions",
                "assemble",
                "critique"
              ]
            }
          },
          "per": { "enum": ["project", "sequence", "scene", "shot", "line"] },
          "requires": { "type": "array", "items": { "$ref": "#/$defs/pattern" } },
          "reads": { "type": "array", "items": { "$ref": "#/$defs/pattern" } },
          "locks": { "type": "array", "items": { "$ref": "#/$defs/pattern" } },
          "paid": { "type": "boolean" },
          "needs": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "$defs": {
    "pattern": {
      "type": "string",
      "pattern": "^(project|script|beat|line|cast|sequence|scene|shot|layer)\\.[a-z_]+$"
    }
  }
}
